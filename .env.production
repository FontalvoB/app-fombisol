# ── production ─────────────────────────────────────────────────────────────
# Build nativo iOS (App Store) apuntando al backend de PRODUCCIÓN.
#
# Backend de producción verificado: https://tech.peoplenet.info (actuator UP).
# ⚠ BLOQUEADOR ACTUAL: su certificado TLS está EXPIRADO (SEC_E_CERT_EXPIRED).
#   iOS (ATS) rechaza certificados inválidos en release: NO publicar a la
#   App Store hasta renovar el certificado en el host del backend.
#
# En CI el valor definitivo lo inyecta GitHub Actions (var
# VITE_API_BASE_URL_PRODUCTION); este archivo es el fallback local.
VITE_APP_ENV=production
VITE_API_BASE_URL=https://tech.peoplenet.info/api
