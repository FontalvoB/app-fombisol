# ── testflight ─────────────────────────────────────────────────────────────
# Build nativo iOS (TestFlight) — QA interna de la empresa.
#
# DECISIÓN 2026-10-07: no existe backend dev desplegado; TestFlight apunta a
# PRODUCCIÓN (misma base que .env.production). Cuando exista un backend dev
# (p. ej. https://dev.peoplenet.info/api) cambiar aquí O crear la variable en
# GitHub (VITE_API_BASE_URL_TESTFLIGHT) que gana sobre este archivo en CI.
VITE_APP_ENV=testflight
VITE_API_BASE_URL=https://peoplenet.info/api
